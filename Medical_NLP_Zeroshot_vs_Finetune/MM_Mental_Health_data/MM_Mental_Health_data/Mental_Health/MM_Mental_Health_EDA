nical literature documents significant diagnostic overlap, and NLP work often merges these categories due to small sample sizes and similar linguistic signals.\n","\n","This merging strategy maintains clinical coherence while reducing extreme class imbalance, making the dataset more suitable for machine-learning classification."],"metadata":{"id":"uF6XGFxUVCAw"}},{"cell_type":"code","source":["# Map Categories\n","mapping = {\n","    'Depression': 'Depressive_Spectrum',\n","    'Suicidal': 'Depressive_Spectrum',\n","    'Bipolar': 'Bipolar/Personality',\n","    'Personality disorder': 'Bipolar/Personality',\n","    'Anxiety': 'Anxiety/Stress',\n","    'Stress': 'Anxiety/Stress',\n","    'Normal': 'Normal'\n","}\n","\n","df_MH['status_combined'] = df_MH['status'].map(mapping)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EZYsEUQ0UqyT","executionInfo":{"status":"ok","timestamp":1763858851393,"user_tz":480,"elapsed":10,"user":{"displayName":"Monica Martin","userId":"10214485714780845175"}},"outputId":"e0fb8699-53a2-4372-eb5a-f9bc02b859f4"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipython-input-2714813222.py:12: SettingWithCopyWarning: \n","A value is trying to be set on a copy of a slice from a DataFrame.\n","Try using .loc[row_indexer,col_indexer] = value instead\n","\n","See the caveats in the documentation: https://pandas.pydata.org/pandas-docs/stable/user_guide/indexing.html#returning-a-view-versus-a-copy\n","  df_MH['status_combined'] = df_MH['status'].map(mapping)\n"]}]},{"cell_type":"code","source":["# Balance\n","plt.figure(figsize=(8,5))\n","sns.countplot(data=df_MH, x='status_combined', palette='viridis')\n","\n","plt.title('Class Distribution After Category Merging')\n","plt.xlabel('Class (Merged Status)')\n","plt.ylabel('Count')\n","plt.xticks(rotation=45)\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":594},"id":"4lqad3iUVYld","execu